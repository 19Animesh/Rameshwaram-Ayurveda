# ─────────────────────────────────────────────────────────────────────────
# Rameshwaram Ayurveda — environment variables
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# Every one of these must ALSO be set in Vercel:
#   Project → Settings → Environment Variables
#
# Variables prefixed NEXT_PUBLIC_ are embedded in the browser bundle and are
# readable by anyone. Never put a secret behind that prefix.
# ─────────────────────────────────────────────────────────────────────────

# ── Required: the app cannot run without these ──────────────────────────

# MongoDB Atlas connection string.
# If your network blocks SRV/DNS lookups (symptom: "querySrv ENOTFOUND"),
# use the non-SRV string from Atlas → Connect → "Connect your application"
# → driver version 2.2.12 or later, which lists hosts explicitly.
# Atlas → Network Access must allow 0.0.0.0/0, because Vercel IPs rotate.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/dbname?retryWrites=true&w=majority

# Signing key for session JWTs. Use a long random string, not a word.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Canonical URL (used for metadata, OG tags and sitemap.xml) ──────────
# Local:      http://localhost:3000
# Production: https://your-domain.com   (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cloudinary: product image hosting ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Razorpay: payments ──────────────────────────────────────────────────
# KEY_SECRET is server-only and must never gain a NEXT_PUBLIC_ prefix.
# The public key id is returned to the browser by /api/payment/create-order,
# so it does not need to be exposed as a build-time variable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Firebase: phone number verification during registration ─────────────
# The NEXT_PUBLIC_ Firebase values below are meant to be public — that is how
# the Firebase web SDK is designed. Access is controlled by Firebase Security
# Rules and authorised domains, not by hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-side token verification).
# FIREBASE_PRIVATE_KEY: copy the "private_key" value from the service-account
# JSON onto ONE line, wrapped in double quotes, keeping the literal \n escapes.
# Do NOT copy the comma that follows it in the JSON file. Correct shape:
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# ── Admin access by phone number ────────────────────────────────────────
# Optional. Numbers that get the admin panel after OTP sign-in, comma-separated.
# If this is not set, the list in src/lib/adminPhones.js is used.
# ADMIN_PHONE_NUMBERS="9876543210,9123456789"
